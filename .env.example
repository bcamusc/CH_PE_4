# ============================================================
# Plantilla de variables de entorno — copia este archivo a .env
#   Windows:      Copy-Item .env.example .env
#   macOS/Linux:  cp .env.example .env
# El archivo .env NUNCA se sube al repositorio (esta en .gitignore).
# ============================================================

# --- Pinecone (obligatorio) ---
# API key gratuita en https://app.pinecone.io -> API Keys
PINECONE_API_KEY=
# Nombre del indice Serverless. Si cambias de modelo de embeddings,
# usa un INDEX_NAME nuevo (la dimension cambia y el indice tambien).
INDEX_NAME=rag-tecnico-python
# Namespace dentro del indice (aplica desde la ingesta hasta la busqueda).
NAMESPACE=docs-tecnicos
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Embeddings ---
# huggingface = modelo local, gratis y sin API key (384 dimensiones)
# openai      = text-embedding-3-small (1536 dimensiones, requiere OPENAI_API_KEY)
EMBEDDING_PROVIDER=huggingface
# OPENAI_API_KEY=          # solo si EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=         # opcional: sobreescribe el modelo por defecto del proveedor

# --- Pipeline ---
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=5
# Pesos del EnsembleRetriever (Reciprocal Rank Fusion): lexico y semantico.
PESO_BM25=0.5
PESO_VECTORIAL=0.5
